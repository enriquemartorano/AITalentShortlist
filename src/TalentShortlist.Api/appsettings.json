{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DemoLimits": {
    "EvaluationsPerIpPerHour": 500,
    "GlobalEvaluationsPerHour": 1000
  },
  "OpenAI": {
    "Model": "gpt-5-mini",
    "Endpoint": "https://api.openai.com/v1/chat/completions",
    "TimeoutSeconds": 120,
    "ReasoningEffort": "low",
    "MaxCompletionTokens": 8000
  }
}
